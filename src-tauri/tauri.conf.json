{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfluencerForge",
  "version": "0.1.0",
  "identifier": "dev.influencerforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InfluencerForge",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/workflows/*",
      "resources/bootstrap/*",
      "resources/python/**/*",
      "resources/forge-python/**/*"
    ]
  },
  "plugins": {}
}
