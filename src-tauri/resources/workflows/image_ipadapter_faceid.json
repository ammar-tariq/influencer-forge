{
  "name": "image_ipadapter_faceid",
  "description": "SDXL txt2img + IP-Adapter FaceID Plus (ComfyUI_IPAdapter_plus). Falls back to img2img when nodes/weights missing.",
  "stub": false,
  "model": "sdxl-faceid",
  "meta": {
    "positive_node": "6",
    "negative_node": "7",
    "seed_node": "3",
    "size_node": "5",
    "checkpoint_node": "4",
    "image_node": "10",
    "ipadapter_node": "12",
    "clip_vision_node": "13",
    "faceid_apply_node": "14",
    "required_nodes": [
      "IPAdapterModelLoader",
      "CLIPVisionLoader",
      "IPAdapterFaceID"
    ],
    "ipadapter_file": "ip-adapter-faceid-plusv2_sdxl.bin",
    "clip_vision_file": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors"
  },
  "prompt": {
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 28,
        "cfg": 5.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1,
        "model": ["14", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "RealVisXL_V5.0_fp16.safetensors"
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 576,
        "height": 1024,
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "POSITIVE_PROMPT",
        "clip": ["4", 1]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "NEGATIVE_PROMPT",
        "clip": ["4", 1]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "influencerforge",
        "images": ["8", 0]
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "FACE_REFERENCE.png"
      }
    },
    "12": {
      "class_type": "IPAdapterModelLoader",
      "inputs": {
        "ipadapter_file": "ip-adapter-faceid-plusv2_sdxl.bin"
      }
    },
    "13": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors"
      }
    },
    "14": {
      "class_type": "IPAdapterFaceID",
      "inputs": {
        "model": ["4", 0],
        "ipadapter": ["12", 0],
        "image": ["10", 0],
        "clip_vision": ["13", 0],
        "weight": 0.75,
        "weight_faceidv2": 1.0,
        "weight_type": "linear",
        "combine_embeds": "concat",
        "start_at": 0.0,
        "end_at": 1.0,
        "embeds_scaling": "V only",
        "insightface": ["15", 0]
      }
    },
    "15": {
      "class_type": "IPAdapterInsightFaceLoader",
      "inputs": {
        "provider": "CPU",
        "model_name": "buffalo_l"
      }
    }
  }
}
